{
  "name": "geoguessr-helper-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "NODE_ENV=test tsx --test \"src/**/*.test.ts\"",
    "hardening:check": "NODE_ENV=test tsx --test src/app.module.hardening.test.ts src/config/app.config.hardening.test.ts",
    "test:coverage": "NODE_ENV=test c8 --reporter=text --reporter=lcov --check-coverage --lines 80 --functions 80 --branches 75 --exclude='src/**/*.test.ts' tsx --test \"src/**/*.test.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "sync:carmeta": "tsx scripts/sync-carmeta.ts",
    "sync:data": "tsx scripts/sync-geocarhelpdesk.ts && pnpm merge:crawlers",
    "sync:data:pull": "git -C ../../GeoCarHelpDesk pull --ff-only && pnpm sync:data",
    "migrate:useful-maps": "tsx scripts/migrate-useful-maps-legacy.ts",
    "crawl:guides": "tsx crawlers/plonk/crawl-guides.ts",
    "consolidate:guides": "tsx crawlers/plonk/consolidate.ts",
    "extract:guides": "tsx crawlers/plonk/extract-guide-data.ts",
    "merge:crawlers": "tsx crawlers/plonk/append-crawler-data-to-backend-data.ts",
    "extract:guides:ai": "tsx crawlers/agent/extract-guide-data-ai.ts",
    "merge:ai": "tsx crawlers/agent/merge-ai-extraction.ts",
    "pipeline:ai": "pnpm extract:guides:ai && pnpm merge:ai"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "11.2.1",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "^17.4.2",
    "fastify": "5.12.0",
    "pg": "^8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.117.0",
    "@nestjs/testing": "11.2.1",
    "@types/node": "25.9.5",
    "@types/supertest": "7.2.1",
    "c8": "^12.0.0",
    "prisma": "^7.8.0",
    "puppeteer": "25.7.0",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
