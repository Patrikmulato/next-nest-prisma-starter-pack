{
  "name": "coach-patrik",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "dev:backend": "pnpm --filter coach-patrik-backend dev",
    "build": "next build",
    "build:backend": "pnpm --filter coach-patrik-backend build",
    "start": "next start",
    "test:backend": "pnpm --filter coach-patrik-backend test",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "ci": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "codecov": "3.8.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": "node ./scripts/lint-staged-tsc.js",
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-ignore",
      "prettier --write"
    ],
    "src/**/*.{js,jsx,ts,tsx}": [
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
